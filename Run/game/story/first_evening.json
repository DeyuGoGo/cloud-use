      "scene": "station",
      "time": "週五 19:22",
      "bg": "xinyi",
      "cast": [
        "jason"
      ],
      "kind": "scene",
      "speaker": "旁白",
      "text": "Jason 壓低聲音：「幹嘛，你也是自己來的喔？」",
      "choices": [
        {
          "label": "「不是說這裡沒辦法跑？」",
